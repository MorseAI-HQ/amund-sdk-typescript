{
  "name": "morse",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:security:node-forge": "node --test scripts/security/node-forge-verification.test.mjs",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "pre-commit": "pre-commit run --all-files",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "cd apps/api && uv run python manage.py migrate",
    "db:makemigrations": "cd apps/api && uv run python manage.py makemigrations",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 5 && cd apps/api && uv run python manage.py migrate",
    "setup": "pnpm install && cd apps/api && uv sync && cd ../.. && docker compose up -d && sleep 5 && cd apps/api && uv run python manage.py migrate",
    "generate:api-types": "node ./scripts/generate-api-types.mjs",
    "docs:screenshots": "node apps/docs/scripts/capture-screenshots.mjs",
    "generate:types": "turbo run generate:api-types --filter=@morsehq/api",
    "test:e2e": "turbo test:e2e --filter=@morsehq/e2e",
    "test:e2e:admin": "pnpm --filter=@morsehq/e2e test:e2e:admin",
    "test:e2e:web": "pnpm --filter=@morsehq/e2e test:e2e:web",
    "sdk:test": "cd apps/sdk/python && uv run pytest tests/ -v",
    "sdk:lint": "cd apps/sdk/python && uv run ruff check src/ tests/",
    "sdk:build": "cd apps/sdk/python && uv run python -m build",
    "sdk:setup": "cd apps/sdk/python && uv sync",
    "test:security:dependencies": "node --test scripts/security/dependency-consumers.test.mjs"
  },
